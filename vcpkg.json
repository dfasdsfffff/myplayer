{
  "name": "myplayer",
  "version-string": "1.0.0",
  "builtin-baseline": "7f3781e19cc7d4e4882a4caec01668c6f7b5c163",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avdevice",
        "avfilter",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    "libass",
    {
      "name": "fontconfig",
      "platform": "osx"
    },
    {
      "name": "sdl2",
      "features": [
        "alsa"
      ],
      "platform": "linux"
    },
    {
      "name": "sdl2",
      "platform": "!linux"
    },
    {
      "name": "soundtouch",
      "features": [
        "soundtouchdll"
      ],
      "platform": "windows & !static"
    },
    {
      "name": "soundtouch",
      "platform": "!windows | static"
    }
  ]
}
