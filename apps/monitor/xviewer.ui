background-color: #252525;
}
#cams{
background-color: #1e1e1e;
}
#status{
color:rgb(255, 255, 255)
}
/*tab 菜单切换*/
#preview{
background-color: #323232;
}
#playback{
background-color: #323232;
}
#preview:checked{
background-color: rgb(0,102,184);
}
#playback:checked{
background-color: rgb(0,102,184);
}
