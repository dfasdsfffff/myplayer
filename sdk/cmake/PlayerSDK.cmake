option(PLAYER_SDK_BUILD_QT "Build Qt Widgets integration" OFF)
option(PLAYER_SDK_BUILD_EXAMPLES "Build SDK examples" OFF)
option(PLAYER_SDK_BUILD_TESTS "Build public API tests" OFF)
set(PLAYERDEMO_DEPS_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party" CACHE PATH "Third-party source root")
set(PLAYERDEMO_SIGSLOT_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/sigslot" CACHE PATH "sigslot root")
if(NOT EXISTS "${PLAYERDEMO_SIGSLOT_ROOT}/include/sigslot/signal.hpp")
    message(FATAL_ERROR "sigslot 1.2.3 is required. Set PLAYERDEMO_SIGSLOT_ROOT; see README.md")
endif()
if(NOT FFMPEG_FOUND)
    find_package(FFMPEG REQUIRED)
endif()
if(NOT TARGET SDL2::SDL2)
    find_package(SDL2 CONFIG REQUIRED)
endif()
if(NOT TARGET SoundTouch::SoundTouchDLL)
    find_package(SoundTouch CONFIG REQUIRED)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MyPlayerWarnings.cmake")
if(PLAYER_SDK_BUILD_QT)
    find_package(Qt6 6.8 REQUIRED COMPONENTS Core Gui Widgets)
    qt_standard_project_setup(REQUIRES 6.8)
endif()
add_subdirectory(core)
if(PLAYER_SDK_BUILD_QT)
    add_subdirectory(qt)
endif()
if(PLAYER_SDK_BUILD_EXAMPLES)
    add_subdirectory(examples)
endif()
if(PLAYER_SDK_BUILD_TESTS)
    enable_testing()
    add_subdirectory(tests/api)
endif()
