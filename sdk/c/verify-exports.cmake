execute_process(COMMAND "${LINKER}" /dump /exports "${DLL}"
    RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect ${DLL}: ${errors}")
endif()
file(STRINGS "${BASELINE}" expected)
string(REGEX MATCHALL "\n +[0-9]+ +[0-9A-Fa-f]+ +[0-9A-Fa-f]+ +[^ \r\n]+" rows "${listing}")
set(actual)
foreach(row IN LISTS rows)
    string(REGEX REPLACE ".* +([^ ]+)$" "\\1" symbol "${row}")
    list(APPEND actual "${symbol}")
endforeach()
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected C ABI exports. Expected: ${expected}. Actual: ${actual}")
endif()
